# Gmail SMTP / local REV.CC. Merge into .env; preserve Neon/Redis/Kakao/session settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
# Enter your full Gmail address locally. Never commit actual credentials.
SMTP_USERNAME=
# Google app password, NOT your normal Google account password.
SMTP_PASSWORD=
# For the initial Gmail test, use the same address as SMTP_USERNAME.
SMTP_FROM=
# User-provided random secret, at least 32 characters. Do not commit.
PASSWORD_RESET_SECRET=
PASSWORD_RESET_URL=http://localhost:8090/password-reset
# Redis session store password (letters/digits only, e.g. `openssl rand -hex 32`). Required with
# docker-compose.prod.yml; the base compose falls back to a local-only default when unset.
REDIS_PASSWORD=
