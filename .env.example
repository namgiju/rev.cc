# REV.CC environment template. Copy to .env and fill in real values locally.
# Never commit .env or real credentials. Every value below is a placeholder or a safe default.
# Keep comments on their own lines: with an empty value, an inline "# ..." would become the value.
#
# [prod]  required by docker-compose.prod.yml (startup fails when missing)
# [base]  used by the assignment compose (docker-compose.yml); a local default applies when unset
# [opt]   optional tuning; the default shown is used when unset

# --- Database: production is Neon PostgreSQL (core/board connect with sslmode=require) ---
# [prod][base]
DB_HOST=your-project.region.aws.neon.tech
# [opt] default 5432
DB_PORT=5432
# [prod][base]
DB_NAME=neondb
# [prod][base]
DB_USER=your_db_user
# [prod][base]
DB_PASSWORD=change-me

# [base] Local postgres container of the assignment compose only (removed in prod). Default: revcc
POSTGRES_PASSWORD=

# --- DB connection pools (application.yml / board-service/src/db-pool.js) ---
# Budget: core 10 + board 10 = 20 at steady state, 40 while old and new containers overlap during
# a redeploy. Neon max_connections was 901 (897 for non-superusers) on 2026-09-30; keep headroom.
# [opt] Hikari maximum-pool-size
CORE_DB_POOL_MAX=10
# [opt] Hikari minimum-idle
CORE_DB_POOL_MIN_IDLE=2
# [opt] pg.Pool max
BOARD_DB_POOL_MAX=10
# [opt] How long a request waits for a pooled connection before failing with 503 (ms)
DB_CONNECTION_TIMEOUT_MS=5000
# Query response limits are not passed by compose; they default to 15 s in code
# (core DB_SOCKET_TIMEOUT_S, board PG_QUERY_TIMEOUT_MS) so a hung DB still ends in 503.

# --- Redis session store ---
# [prod][base] Letters/digits only, e.g. `openssl rand -hex 32`. Base compose uses a local-only
# default when unset.
REDIS_PASSWORD=

# --- Session cookie ---
# [base] The prod profile always sends Secure cookies (HTTPS must terminate in front of nginx).
SESSION_COOKIE_SECURE=false

# --- Kakao login ---
# [base] Required for Kakao login
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# [prod][base] Must be the production HTTPS callback in prod,
# e.g. https://example.com/api/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# --- Password reset mail (Gmail SMTP example) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
# Full Gmail address
SMTP_USERNAME=
# Google app password, NOT your normal Google account password
SMTP_PASSWORD=
# Usually the same address as SMTP_USERNAME
SMTP_FROM=
# Random secret, at least 32 characters
PASSWORD_RESET_SECRET=
# Public URL in prod
PASSWORD_RESET_URL=http://localhost:8090/password-reset

# --- Member withdrawal ---
# [prod required] HMAC key for re-signup blocks after withdrawal (at least 32 random characters,
# e.g. openssl rand -hex 32). Stored identifiers are HMACs of this key; changing it releases every
# existing block, so follow docs/member-withdrawal.md. Empty = withdrawal is refused (503) outside prod.
WITHDRAWAL_HMAC_SECRET=

# --- Cloudflare Named Tunnel (prod only) ---
# [prod] Token of the remotely-managed tunnel (Zero Trust > Networks > Tunnels > the tunnel > install
# command, the long value after --token). It lets anyone run this tunnel: treat it like a password.
# Public Hostname in the dashboard: rev.cc -> http://proxy:80
CLOUDFLARE_TUNNEL_TOKEN=

# --- Host ports (local) ---
# [opt] proxy published port (assignment compose only; prod publishes no port, traffic enters via the tunnel)
REVCC_PORT=8090
# [opt] docker-compose.garage.yml only
GARAGE_PORT=3000
